      function esc(s) {
        if (s === null || s === undefined) return "";
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c],
        );
      }

      function debounce(fn, ms) {
        let t;
        return (...a) => {
          clearTimeout(t);
          t = setTimeout(() => fn(...a), ms);
        };
      }

      function rowMatchesSearch(rec, cols, q) {
        if (!q) return true;
        const needle = q.trim().toLowerCase();
        if (!needle) return true;
        for (const c of cols) {
          const v = rec[c];
          if (
            v !== null &&
            v !== undefined &&
            String(v).toLowerCase().includes(needle)
          )
            return true;
        }
        return false;
      }

      function rowMatchesFilters(rec, filters) {
        for (const [col, vals] of Object.entries(filters)) {
          if (!vals || vals.length === 0) continue;
          const v =
            rec[col] === null || rec[col] === undefined ? "" : String(rec[col]);
          if (!vals.includes(v)) return false;
        }
        return true;
      }

      function isFlaggedRow(sheet, rec) {
        const marks = ISSUE_MARKS[sheet];
        if (!marks) return [];
        const hits = [];
        for (const [pid, spec] of Object.entries(marks)) {
          const specs = Array.isArray(spec) ? spec : [spec];
          let matched = false;
          for (const s of specs) {
            if (typeof s === "function") {
              try {
                if (s(rec)) {
                  matched = true;
                  break;
                }
              } catch (_) {}
            } else {
              let m = true;
              for (const [k, v] of Object.entries(s)) {
                if (String(rec[k]) !== String(v)) {
                  m = false;
                  break;
                }
              }
              if (m) {
                matched = true;
                break;
              }
            }
          }
          if (matched) hits.push(pid);
        }
        return hits;
      }

