          return `<span class="badge b-gray fx-badge" title="formula ไม่ถูกคำนวณ">ƒx</span>`;
        }
        return esc(v);
      }

      // ============================================================
      // STATS (derive จาก data จริง)
      // ============================================================
      function computeStats() {
        const s = STATE.data.sheets;
        const totalRows = Object.values(s).reduce((a, x) => a + x.row_count, 0);
        const fixLogRows = s.FIX_LOG ? s.FIX_LOG.row_count : 0;
        return {
          sheets: Object.keys(s).length,
          totalRows,
          issues: ISSUE_SUMMARY.length,
          fixed: STATS_OVERRIDE.fixed,
          needEvidence: STATS_OVERRIDE.needEvidence,
          fixLogEntries: fixLogRows,
        };
      }

      // ============================================================
      // VIEWS
      // ============================================================
      function renderOverview() {
        const s = STATE.data.sheets;
        const st = computeStats();
        return `
    <div class="stats">
      <div class="stat"><div class="n">${st.sheets}</div><div class="l">Sheets</div></div>
      <div class="stat"><div class="n">${st.totalRows}</div><div class="l">Total Rows</div></div>
      <div class="stat"><div class="n">${st.issues}</div><div class="l">Issues Found</div></div>
      <div class="stat"><div class="n">${st.fixed}</div><div class="l">Fixed</div></div>
      <div class="stat"><div class="n">${st.needEvidence}</div><div class="l">Need Evidence</div></div>
      <div class="stat"><div class="n">${st.fixLogEntries}</div><div class="l">Fix Log Entries</div></div>
    </div>
    <h2 style="font-size:15px;margin:0 0 10px">Issues Overview — คลิกเพื่อดู row ที่ flag</h2>
    <div class="issues">
      ${ISSUE_SUMMARY.map((i) => {
        const hasMap = Object.keys(ISSUE_MARKS).some(
          (sh) => ISSUE_MARKS[sh][i.id],
        );
        return `
          <div class="issue ${i.level} ${hasMap ? "" : "no-map"}" data-issue="${i.id}" data-has-map="${hasMap}" data-tip="${(ISSUE_DESCRIPTIONS[i.id] || "").replace(/"/g, "&quot;")}" title="${(ISSUE_DESCRIPTIONS[i.id] || "").replace(/"/g, "&quot;")}">
            <h4>${i.id} — ${i.t}</h4>
            <p>${i.d}</p>
          </div>
        `;
      }).join("")}
    </div>
    <h2 style="font-size:15px;margin:20px 0 10px">Sheets</h2>
    <table>
      <thead><tr><th>Sheet</th><th>Rows</th><th>Columns</th><th>Flagged</th></tr></thead>
      <tbody>
        ${Object.entries(s)
          .map(([name, d]) => {
            const flagged = d.records.filter(
              (r) => isFlaggedRow(name, r).length > 0,
            ).length;
            return `<tr>
            <td><b>${esc(name)}</b></td>
            <td>${d.row_count}</td>
            <td>${d.headers.length}</td>
            <td>${flagged ? `<span class="badge b-review">${flagged}</span>` : ""}</td>
          </tr>`;
          })
          .join("")}
      </tbody>
    </table>
  `;
      }

      function isColHidden(sheetName, col) {
        const set = STATE.hiddenCols[sheetName];
        return set ? set.has(col) : false;
      }
      function toggleCol(sheetName, col) {
        STATE.hiddenCols[sheetName] = STATE.hiddenCols[sheetName] || new Set();
        const set = STATE.hiddenCols[sheetName];
        if (set.has(col)) set.delete(col);
        else set.add(col);
      }
      function showAllCols(sheetName) {
        STATE.hiddenCols[sheetName] = new Set();
      }
      function focusOnP(sheetName, pid) {
        // ซ่อนทุก column ปกติ, เหลือเฉพาะ Row, Flag และ evCols ของ pid นั้น
        const s = STATE.data.sheets[sheetName];
        const evCols = getEvidenceColumns(sheetName);
        const keepBase = new Set(["Row", "Flag"]); // pseudo (ไม่ใช่ headers จริง)
        const hide = new Set();
        const evHeaders = new Set();
        for (const c of evCols) {
          if (c.pid !== pid) hide.add("__ev_" + c.pid + "_" + c.label);
        }
        // ซ่อน header ปกติทั้งหมด
        for (const h of s.headers) hide.add(h);
        STATE.hiddenCols[sheetName] = hide;
        STATE.focusP = pid;
      }
      function clearFocus(sheetName) {
        STATE.hiddenCols[sheetName] = new Set();
        STATE.focusP = null;
      }

      function currentFilters(sheet) {
        return STATE.filters[sheet] || {};
      }

      function applyFilters(records, sheet) {
        const cols = STATE.data.sheets[sheet].headers;
        let rows = records.filter((r) =>
          rowMatchesSearch(r, cols, STATE.search),
        );
        rows = rows.filter((r) => rowMatchesFilters(r, currentFilters(sheet)));
        if (STATE.issueFilter) {
          rows = rows.filter((r) =>
            isFlaggedRow(sheet, r).includes(STATE.issueFilter),
          );
        }
        // truth filter: { sheetName: { P3: 'true'|'false' } }
        const tf = STATE.truthFilter[sheet];
        if (tf && Object.keys(tf).length) {
          const ctx = {
            sheet: (name) =>
              STATE.data.sheets[name] ? STATE.data.sheets[name].records : [],
          };
          for (const [pid, want] of Object.entries(tf)) {
            if (!want) continue;
            const rule = EVIDENCE_RULES[pid];
            if (!rule) continue;
            const mc = (rule.cols || []).find(
              (c) => typeof c.computeMatch === "function",
            );
            if (!mc) continue;
            rows = rows.filter((r) => {
              try {
                const ok = !!mc.computeMatch(r, ctx);
                return want === "true" ? ok : !ok;
              } catch (_) {
                return false;
              }
            });
          }
        }
        return rows;
      }

      function renderToolbar(sheet) {
        const cols = FILTER_COLS[sheet] || [];
