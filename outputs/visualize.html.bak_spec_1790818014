            .sort();
          const cur = filters[col] || [];
          return `<select data-filter-col="${esc(col)}">
          <option value="">${esc(col)}: ทั้งหมด</option>
          ${uniq.map((v) => `<option value="${esc(v)}" ${cur.includes(v) ? "selected" : ""}>${esc(v)}</option>`).join("")}
        </select>`;
        })
        .join("")}
      ${activeTags.length ? `<button class="clear-filters" id="clear-filters">ล้างทั้งหมด</button>` : ""}
      <button class="col-picker-btn" id="col-picker-btn">⚙ คอลัมน์ (${allCols.length + allEv.length - hiddenNormal - hiddenEv}/${allCols.length + allEv.length})</button>
      <button class="col-picker-btn" id="truth-picker-btn">✓ เงื่อนไขจริง/เท็จ</button>
    </div>
    <div class="truth-picker" id="truth-picker" style="display:none">
      <p style="font-size:12px;color:#4a5568;margin:0 0 8px">
        เลือกกรองตามผลเงื่อนไขของแต่ละ P (ทุก row จะคำนวณจริง/เท็จอัตโนมัติ)
      </p>
      ${pids
        .filter(
          (p) =>
            (EVIDENCE_RULES[p] || {}).cols &&
            (EVIDENCE_RULES[p].cols || []).some((c) => c.computeMatch),
        )
        .map((p) => {
          const cur = (STATE.truthFilter[sheet] || {})[p] || "";
          return `<div class="truth-row">
          <span class="ev-pid-inline">${esc(p)}</span>
          <span class="truth-label">${esc((EVIDENCE_RULES[p] || {}).condition || "")}</span>
          <div class="truth-btns">
            <button data-truth-p="${esc(p)}" data-truth-v=""      class="${cur === "" ? "active" : ""}">ทั้งหมด</button>
            <button data-truth-p="${esc(p)}" data-truth-v="true"  class="${cur === "true" ? "active" : ""}">จริง</button>
            <button data-truth-p="${esc(p)}" data-truth-v="false" class="${cur === "false" ? "active" : ""}">เท็จ</button>
          </div>
        </div>`;
        })
        .join("")}
      ${Object.keys(STATE.truthFilter[sheet] || {}).length ? `<button class="clear-filters" id="truth-clear">ล้างเงื่อนไข</button>` : ""}
    </div>
    <div class="col-picker" id="col-picker" style="display:none">
      <div class="col-picker-head">
        <b>คอลัมน์ปกติ</b>
        <button data-show-all="normal">แสดงทั้งหมด</button>
        <button data-hide-all="normal">ซ่อนทั้งหมด</button>
      </div>
      <div class="col-picker-grid">
        ${allCols.map((c) => `<label><input type="checkbox" data-col="${esc(c)}" ${isColHidden(sheet, c) ? "" : "checked"}> ${esc(c)}</label>`).join("")}
      </div>
      <div class="col-picker-head">
        <b>คอลัมน์เงื่อนไข (P)</b>
        <button data-show-all="ev">แสดงทั้งหมด</button>
        <button data-hide-all="ev">ซ่อนทั้งหมด</button>
      </div>
      <div class="col-picker-grid">
        ${allEv
          .map((c) => {
            const key = "__ev_" + c.pid + "_" + c.label;
            return `<label><input type="checkbox" data-col="${esc(key)}" data-pid="${esc(c.pid)}" ${isColHidden(sheet, key) ? "" : "checked"}> <span class="ev-pid-inline">${esc(c.pid)}</span> ${esc(c.label)}</label>`;
          })
          .join("")}
      </div>
      <div class="col-picker-head"><b>โฟกัสเฉพาะ P</b></div>
      <div class="col-picker-focus">
        <button data-focus="none" class="${STATE.focusP ? "" : "active"}">ทั้งหมด</button>
        ${pids.map((p) => `<button data-focus="${esc(p)}" class="${STATE.focusP === p ? "active" : ""}">${esc(p)}</button>`).join("")}
      </div>
    </div>
  `;
      }

      function renderInfoLine(sheet, filteredCount, totalCount) {
        return `<p class="info-line">
    แสดง <b>${filteredCount}</b> / ${totalCount} rows
    ${STATE.issueFilter ? `• กรองเฉพาะ issue <b>${STATE.issueFilter}</b>` : ""}
  </p>`;
      }

      function renderTable(sheet, rows) {
        const allCols = STATE.data.sheets[sheet].headers.slice(0, 20);
        const cols = allCols.filter((c) => !isColHidden(sheet, c));
        const allEvCols = getEvidenceColumns(sheet);
        const evCols = allEvCols.filter(
          (c) => !isColHidden(sheet, "__ev_" + c.pid + "_" + c.label),
        );
        const ctx = {
          sheet: (name) =>
            STATE.data.sheets[name] ? STATE.data.sheets[name].records : [],
        };
        const start = (STATE.page - 1) * STATE.pageSize;
        const pageRows = rows.slice(start, start + STATE.pageSize);

        const body = pageRows
          .map((r) => {
            const hits = isFlaggedRow(sheet, r);
            return `<tr>
      <td>${r._row}</td>
      <td>${
        hits.length
          ? `<span class="row-flag">${hits
              .map((h) => {
                const tip = (ISSUE_DESCRIPTIONS[h] || "").replace(
                  /"/g,
                  "&quot;",
                );
                return `<span class="badge b-review p-badge" data-tip="${tip}" title="${tip}">${h}</span>`;
              })
              .join("")}</span>`
          : ""
      }</td>
      ${cols
        .map((c) => {
          const v = r[c];
          const full = v === null || v === undefined ? "" : String(v);
          const cell = badgeFor(c, v);
          const isBadge = cell !== esc(full);
          const trunc = full.length > 60 ? full.slice(0, 60) + "…" : full;
          const title = full.length > 60 ? ` title="${esc(full)}"` : "";
          return `<td class="truncate"${title}>${isBadge ? cell : esc(trunc)}</td>`;
        })
        .join("")}
      ${evCols
        .map((c) => {
          const flagged = hits.includes(c.pid);
          const rule = EVIDENCE_RULES[c.pid] || {};
          const br = getBeforeRow(sheet, r);
          const ir = getInputRow(sheet, r);
          let curDisplay = "",
            befDisplay = null,
            inpDisplay = null,
            cls = "ev-flag-col";
          const tip = `P${c.pid}: ${rule.condition ||""}`;
          try {
            if (typeof c.computeMatch === "function"){
              const curOk = !!c.computeMatch(r, ctx);
              let befOk = null, inpOk = null;
              if (br) { try { befOk = !!c.computeMatch(br, ctx); } catch (_) {} }
              if (ir) { try { inpOk = !!c.computeMatch(ir, ctx); } catch (_) {} }
              curDisplay = curOk ? "จริง" : "เท็จ";
              befDisplay = befOk === null ? null : befOk ? "จริง" : "เท็จ";
              inpDisplay = inpOk === null ? null : inpOk ? "จริง" : "เท็จ";
              cls = curOk ? "ev-match-ok" : "ev-match-fail";
            } else if (typeof c.get === "function") {
              const v = c.get(r, ctx);
              curDisplay = v == null || v === "" ? "∅" : String(v);
              if (br) {
                try {
                  const bv = c.get(br, ctx);
                  befDisplay = bv == null || bv === "" ? "∅" : String(bv);
                } catch (_) { befDisplay = null; }
              }
              if (ir) {
                try {
                  const iv = c.get(ir, ctx);
                  inpDisplay = iv == null || iv === "" ? "∅" : String(iv);
                } catch (_) { inpDisplay = null; }
              }
              // ── สีเปลี่ยน: เหลืองเฉพาะเมื่อ Before ≠ After ──
              const hasChange = (br === null)  // ← row ใหม่ (Before ไม่มี)
                             || (befDisplay !== null && befDisplay !== curDisplay)
                             || (inpDisplay !== null && inpDisplay !== curDisplay);
              if (hasChange) {
                cls = "ev-flag-col";  // เหลือง = มีการเปลี่ยนแปลง
              } else {
                cls = "ev-passive";   // เทา = ไม่เปลี่ยน
              }
            }
          } catch (e) {
            curDisplay = "ERR";
            cls = "ev-match-fail";
          }
          let cellHtml;
          // 3-way: ถ้ามี input → Input → After
          if (inpDisplay !== null && inpDisplay !== curDisplay) {
            cellHtml = `<span class="ev-input" title="Input (source of truth)">${esc(inpDisplay)}</span><span class="ev-arrow">→</span><span class="ev-after">${esc(curDisplay)}</span>`;
          } else if (inpDisplay !== null) {
            // input ตรงกับ after → แสดงแค่ after
            cellHtml = esc(curDisplay);
          } else if (befDisplay !== null && befDisplay !== curDisplay) {
            cellHtml = `<span class="ev-before" title="Before (sanitized)">${esc(befDisplay)}</span><span class="ev-arrow">→</span><span class="ev-after">${esc(curDisplay)}</span>`;
          } else {
            cellHtml = esc(curDisplay);
          }
          return `<td class="ev-cell ${cls}" title="${esc(tip)}">${cellHtml}</td>`;
        })
        .join("")}
    </tr>`;
          })
          .join("");

        return `
    <table id="data-table">
      <thead><tr>
        <th>Row</th><th>Flag</th>
        ${cols.map((c) => `<th>${esc(c)}</th>`).join("")}
        ${evCols
          .map((c) => {
            const cond = esc((EVIDENCE_RULES[c.pid] || {}).condition || "");
            const tip = `P${c.pid}: ${cond}\n${c.label}`;
            return `<th class="ev-th" data-p="${esc(c.pid)}" title="${tip.replace(/"/g, "&quot;")}"><span class="ev-pid">P${esc(c.pid)}</span><span class="ev-lbl">${esc(c.label)}</span></th>`;
          })
          .join("")}
      </tr></thead>
      <tbody>
        ${body || `<tr><td colspan="${cols.length + 2 + evCols.length}" class="empty">ไม่พบข้อมูล</td></tr>`}
      </tbody>
    </table>
  `;
      }

      function renderPagination(rowsLength) {
        const pages = Math.max(1, Math.ceil(rowsLength / STATE.pageSize));
        if (pages <= 1) return "";
        return `
    <div class="pagination">
      <button id="prev-page" ${STATE.page === 1 ? "disabled" : ""}>← ก่อนหน้า</button>
      <span>หน้า ${STATE.page} / ${pages}</span>
      <button id="next-page" ${STATE.page === pages ? "disabled" : ""}>ถัดไป →</button>
    </div>
  `;
      }

      function renderSheet(sheet) {
        const s = STATE.data.sheets[sheet];
        if (!s) return '<div class="empty">ไม่พบ sheet</div>';
        const rows = applyFilters(s.records, sheet);
        return `
    <h2 style="font-size:15px;margin:0 0 10px">${esc(sheet)}</h2>
    <p style="font-size:12px;color:#718096;margin:0 0 10px">
      ${s.row_count} rows • ${s.headers.length} columns
    </p>
    ${renderToolbar(sheet)}
    ${renderInfoLine(sheet, rows.length, s.records.length)}
    <div class="ev-legend">
      <span><span class="sw sw-ok"></span>จริง</span>
      <span><span class="sw sw-fail"></span>เท็จ</span>
      <span><span class="sw sw-flag"></span>ค่าของ P ที่ flag</span>
      <span><span class="sw sw-none"></span>ไม่เกี่ยวข้อง</span>
    </div>
    <div class="ev-legend">
      <span><span class="sw sw-ok"></span>จริง (เงื่อนไขตรง)</span>
      <span><span class="sw sw-fail"></span>เท็จ (เงื่อนไขไม่ตรง)</span>
      <span><span class="sw sw-flag"></span>ค่าของ P ที่ flag row นี้</span>
      <span><span class="sw sw-none"></span>ไม่เกี่ยวข้อง</span>
    </div>
    ${renderTable(sheet, rows)}
    ${renderPagination(rows.length)}
  `;
      }

      // ============================================================
      // RENDER / REFRESH
      // ============================================================
      function render(view) {
        STATE.view = view;
        const main = document.getElementById("main");
        if (view === "overview") {
          main.innerHTML = renderOverview();
          main.querySelectorAll(".issue").forEach((el) => {
            el.addEventListener("click", () => {
              const id = el.dataset.issue;
              for (const sheetName of Object.keys(ISSUE_MARKS)) {
                if (ISSUE_MARKS[sheetName][id]) {
                  STATE.issueFilter = id;
                  STATE.page = 1;
                  goto(sheetName);
                  return;
                }
              }
              // ไม่มี mapping — ไม่ navigate แต่แจ้งเตือนเบา ๆ
              // (ไม่ใช้ alert() เพื่อไม่ให้กวนตอน screenshot)
              el.classList.add("no-map");
            });
          });
        } else {
          main.innerHTML = renderSheet(view);
          attachSheetEvents(view);
        }
        document.querySelectorAll("nav button").forEach((b) => {
          b.classList.toggle("active", b.dataset.view === view);
        });
      }

      // refresh เฉพาะส่วนที่เปลี่ยน — ใช้ตอน filter / pagination / clear
      function refreshSheetView(sheet) {
        const main = document.getElementById("main");
        const s = STATE.data.sheets[sheet];
        const rows = applyFilters(s.records, sheet);

        const toolbar = main.querySelector(".toolbar");
        if (toolbar) toolbar.outerHTML = renderToolbar(sheet);

        const info = main.querySelector(".info-line");
        if (info)
          info.outerHTML = renderInfoLine(sheet, rows.length, s.records.length);

        const table = main.querySelector("#data-table");
        if (table) table.outerHTML = renderTable(sheet, rows);

        const pag = main.querySelector(".pagination");
        if (pag) pag.remove();
        const newPag = renderPagination(rows.length);
        if (newPag) main.insertAdjacentHTML("beforeend", newPag);

        attachSheetEvents(sheet);
      }

      // search — update เฉพาะ info + table + pagination โดยไม่แตะ toolbar
      function refreshSearchResults(sheet) {
        const main = document.getElementById("main");
        const s = STATE.data.sheets[sheet];
        const rows = applyFilters(s.records, sheet);

        const info = main.querySelector(".info-line");
        if (info)
          info.outerHTML = renderInfoLine(sheet, rows.length, s.records.length);

        const table = main.querySelector("#data-table");
        if (table) table.outerHTML = renderTable(sheet, rows);

        const pag = main.querySelector(".pagination");
        if (pag) pag.remove();
        const newPag = renderPagination(rows.length);
        if (newPag) main.insertAdjacentHTML("beforeend", newPag);

        attachTableEvents(sheet);
      }

      function attachTableEvents(sheet) {
        const main = document.getElementById("main");
        const prev = main.querySelector("#prev-page");
        if (prev)
          prev.addEventListener("click", () => {
            STATE.page--;
            refreshSheetView(sheet);
          });
        const next = main.querySelector("#next-page");
        if (next)
          next.addEventListener("click", () => {
            STATE.page++;
            refreshSheetView(sheet);
          });
      }

      function attachSheetEvents(sheet) {
        const main = document.getElementById("main");

        const si = main.querySelector("#search-input");
        if (si && !si.dataset.bound) {
          si.dataset.bound = "1";
          si.addEventListener(
            "input",
            debounce((e) => {
              STATE.search = e.target.value;
              STATE.page = 1;
              refreshSearchResults(sheet);
            }, 180),
          );
        }

        main.querySelectorAll("select[data-filter-col]").forEach((sel) => {
          sel.addEventListener("change", (e) => {
            const col = sel.dataset.filterCol;
            const val = e.target.value;
            if (!STATE.filters[sheet]) STATE.filters[sheet] = {};
            STATE.filters[sheet][col] = val ? [val] : [];
            STATE.page = 1;
            refreshSheetView(sheet);
          });
        });

        main.querySelectorAll("[data-remove-filter]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const col = btn.dataset.removeFilter;
            if (STATE.filters[sheet]) delete STATE.filters[sheet][col];
            STATE.page = 1;
            refreshSheetView(sheet);
          });
        });

        // truth picker toggle
        const tpBtn = main.querySelector("#truth-picker-btn");
        const tp = main.querySelector("#truth-picker");
        if (tpBtn && tp && !tpBtn.dataset.bound) {
          tpBtn.dataset.bound = "1";
          tpBtn.addEventListener("click", () => {
            tp.style.display = tp.style.display === "none" ? "block" : "none";
          });
        }
        if (tp && !tp.dataset.bound) {
          tp.dataset.bound = "1";
          tp.querySelectorAll("[data-truth-p]").forEach((b) => {
            b.addEventListener("click", () => {
              const pid = b.dataset.truthP;
              const v = b.dataset.truthV;
              STATE.truthFilter[sheet] = STATE.truthFilter[sheet] || {};
              if (!v) delete STATE.truthFilter[sheet][pid];
              else STATE.truthFilter[sheet][pid] = v;
              STATE.page = 1;
              refreshSheetView(sheet);
            });
          });
          const tc = tp.querySelector("#truth-clear");
          if (tc)
            tc.addEventListener("click", () => {
              STATE.truthFilter[sheet] = {};
              STATE.page = 1;
              refreshSheetView(sheet);
            });
        }

        // column picker toggle
        const cpBtn = main.querySelector("#col-picker-btn");
        const cp = main.querySelector("#col-picker");
        if (cpBtn && cp && !cpBtn.dataset.bound) {
          cpBtn.dataset.bound = "1";
          cpBtn.addEventListener("click", () => {
            cp.style.display = cp.style.display === "none" ? "block" : "none";
          });
        }
        if (cp && !cp.dataset.bound) {
          cp.dataset.bound = "1";
          cp.querySelectorAll("input[type=checkbox][data-col]").forEach(
            (cb) => {
              cb.addEventListener("change", () => {
                toggleCol(sheet, cb.dataset.col);
                refreshSheetView(sheet);
              });
            },
          );
          cp.querySelectorAll("[data-show-all]").forEach((b) => {
            b.addEventListener("click", () => {
              const kind = b.dataset.showAll;
              if (kind === "normal") {
                STATE.data.sheets[sheet].headers.slice(0, 20).forEach((c) => {
                  const set = STATE.hiddenCols[sheet];
                  if (set) set.delete(c);
                });
              } else {
                getEvidenceColumns(sheet).forEach((c) => {
                  const set = STATE.hiddenCols[sheet];
                  if (set) set.delete("__ev_" + c.pid + "_" + c.label);
                });
              }
              refreshSheetView(sheet);
            });
          });
          cp.querySelectorAll("[data-hide-all]").forEach((b) => {
            b.addEventListener("click", () => {
              const kind = b.dataset.hideAll;
              if (kind === "normal") {
                STATE.hiddenCols[sheet] = STATE.hiddenCols[sheet] || new Set();
                STATE.data.sheets[sheet].headers
                  .slice(0, 20)
                  .forEach((c) => STATE.hiddenCols[sheet].add(c));
              } else {
                STATE.hiddenCols[sheet] = STATE.hiddenCols[sheet] || new Set();
                getEvidenceColumns(sheet).forEach((c) =>
                  STATE.hiddenCols[sheet].add("__ev_" + c.pid + "_" + c.label),
                );
              }
              refreshSheetView(sheet);
            });
          });
          cp.querySelectorAll("[data-focus]").forEach((b) => {
            b.addEventListener("click", () => {
              const pid = b.dataset.focus;
              if (pid === "none") clearFocus(sheet);
              else focusOnP(sheet, pid);
              refreshSheetView(sheet);
            });
          });
        }

        const cf = main.querySelector("#clear-filters");
        if (cf)
          cf.addEventListener("click", () => {
            STATE.filters[sheet] = {};
            STATE.search = "";
            STATE.issueFilter = null;
            STATE.page = 1;
            refreshSheetView(sheet);
          });

        attachTableEvents(sheet);
      }

      // ============================================================
      // NAV
      // ============================================================
      function buildNav() {
        const nav = document.getElementById("nav");
        let html = `<h3>Overview</h3>
    <button data-view="overview">📊 Dashboard</button>
    <h3>Sheets</h3>`;
        for (const [name, d] of Object.entries(STATE.data.sheets)) {
          html += `<button data-view="${esc(name)}">${esc(name)}<span class="count">${d.row_count}</span></button>`;
        }
        nav.innerHTML = html;
        nav.querySelectorAll("button").forEach((b) => {
          b.addEventListener("click", () => {
            STATE.search = "";
            STATE.filters = {};
            STATE.issueFilter = null;
            STATE.page = 1;
            render(b.dataset.view);
          });
        });
      }

      function goto(view) {
        STATE.page = 1;
        render(view);
        document.querySelectorAll("nav button").forEach((b) => {
          b.classList.toggle("active", b.dataset.view === view);
        });
      }

      // ============================================================
      // BOOT
      // ============================================================
      Promise.all([
        fetch("./data.json").then((r) => r.json()),
        fetch("./data_sanitized.json")
          .then((r) => r.json())
          .catch(() => null),
        fetch("./data_input.json")
          .then((r) => r.json())
          .catch(() => null),
      ])
        .then(([d, before, input]) => {
          STATE.data = d;
          window.BEFORE_DATA = before;
          window.INPUT_DATA = input;
          console.log("[INPUT_DATA]", input ? Object.keys(input.sheets).length + " sheets" : "not loaded");

          // P6_IDS: Comment ID ที่ผล 30m ≠ 24h (transitions)
          window.P6_IDS = new Set();
          try {
            const recs =
              (d.sheets.COMMENT_RECHECK && d.sheets.COMMENT_RECHECK.records) ||
              [];
            const byId = {};
            for (const r of recs) {
              const cid = String(r["Comment ID"] ?? "");
              const tp = String(r["Verification Timepoint"] ?? "");
              if (!cid || !tp) continue;
              byId[cid] = byId[cid] || {};
              byId[cid][tp] = String(r["Recheck Result"] ?? "");
            }
            for (const [cid, pair] of Object.entries(byId)) {
              if (pair["30m"] !== pair["24h"]) window.P6_IDS.add(cid);
            }
            console.log("[P6] transition IDs:", window.P6_IDS.size);
          } catch (e) {
            console.warn("P6 init failed", e);
          }
          const st = computeStats();
          document.getElementById("subtitle").textContent =
            `${st.sheets} sheets • ${st.totalRows} rows • ${d.generated_at}`;
          buildNav();
          render("overview");
        })
        .catch((e) => {
          document.getElementById("main").innerHTML = `
      <div class="empty">
        โหลด data.json ไม่ได้: ${esc(e.message)}<br><br>
        รัน: <code>python3 scripts/export_to_json.py</code><br>
        แล้วรัน: <code>python3 -m http.server 8765</code> ใน <code>outputs/</code>
      </div>`;
        });
    </script>
  </body>
</html>
