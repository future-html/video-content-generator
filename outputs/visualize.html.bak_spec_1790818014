        const allCols = STATE.data.sheets[sheet].headers.slice(0, 20);
        const allEv = getEvidenceColumns(sheet);
        const hiddenNormal = allCols.filter((c) =>
          isColHidden(sheet, c),
        ).length;
        const hiddenEv = allEv.filter((c) =>
          isColHidden(sheet, "__ev_" + c.pid + "_" + c.label),
        ).length;
        const pids = [...new Set(allEv.map((c) => c.pid))].sort(
          (a, b) => Number(a.slice(1)) - Number(b.slice(1)),
        );

        return `
    <div class="toolbar">
      <input type="search" id="search-input" placeholder="ค้นหาในทุกคอลัมน์..." value="${esc(STATE.search)}">
      ${cols
        .map((col) => {
