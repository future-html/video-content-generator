<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <title>Whiteshirt Data Visualizer</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: -apple-system, "Helvetica Neue", sans-serif;
        margin: 0;
        background: #f5f7fa;
        color: #1a202c;
      }
      header {
        background: #1a365d;
        color: #fff;
        padding: 16px 24px;
      }
      header h1 {
        margin: 0 0 4px;
        font-size: 20px;
      }
      header p {
        margin: 0;
        opacity: 0.8;
        font-size: 13px;
      }

      .container {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: calc(100vh - 76px);
      }
      nav {
        background: #fff;
        border-right: 1px solid #e2e8f0;
        padding: 16px;
        overflow-y: auto;
      }
      main {
        padding: 20px;
        overflow-y: auto;
      }

      nav h3 {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #718096;
        margin: 16px 0 8px;
      }
      nav button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 8px 12px;
        margin-bottom: 4px;
        border: none;
        background: #edf2f7;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
        font-family: inherit;
      }
      nav button:hover {
        background: #e2e8f0;
      }
      nav button.active {
        background: #3182ce;
        color: #fff;
      }
      nav .count {
        float: right;
        opacity: 0.6;
        font-size: 11px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
      }
      .stat {
        background: #fff;
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 3px solid #3182ce;
      }
      .stat .n {
        font-size: 22px;
        font-weight: 600;
      }
      .stat .l {
        font-size: 11px;
        color: #718096;
        text-transform: uppercase;
      }

      .issues {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
      }
      .issue {
        background: #fff;
        padding: 12px 16px;
        border-radius: 8px;
        border-left: 4px solid #e53e3e;
        cursor: pointer;
      }
      .issue.warn {
        border-left-color: #dd6b20;
      }
      .issue.info {
        border-left-color: #3182ce;
      }
      .issue.no-map {
        cursor: default;
        opacity: 0.75;
      }
    
  .issue.ok { border-left-color: #38a169; }
  .issue.ok::after {
    content: " ✓ resolved";
    font-size: 10px;
    color: #38a169;
    font-weight: 700;
  }
  .issue.warn::after {
    content: " ⚠ ต้องติดตาม";
    font-size: 10px;
    color: #dd6b20;
    font-weight: 700;
  }
  .issue.no-map::after {
        content: " (ไม่มี row mapping)";
        font-size: 10px;
        color: #a0aec0;
      }
      .issue:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .issue h4 {
        margin: 0 0 4px;
        font-size: 13px;
      }
      .issue p {
        margin: 0;
        font-size: 12px;
        color: #4a5568;
      }

        table { width: 100%; border-collapse: separate; border-spacing: 0;
          background: #fff; border-radius: 8px; overflow: visible; font-size: 12px; }
      th {
        background: #edf2f7;
        text-align: left;
        padding: 8px 12px;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        color: #4a5568;
        border-bottom: 1px solid #e2e8f0;
        position: sticky;
        top: 0;
        z-index: 5;
      }
      td {
        padding: 7px 12px;
        border-bottom: 1px solid #edf2f7;
        vertical-align: top;
      }
      tr:hover td {
        background: #f7fafc;
      }

      .badge {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
      }
      .b-ok {
        background: #c6f6d5;
        color: #22543d;
      }
      .b-review {
        background: #fed7d7;
        color: #742a2a;
      }
      .b-fit {
        background: #bee3f8;
        color: #2a4365;
      }
      .b-warn {
        background: #feebc8;
        color: #7b341e;
      }
      .b-gray {
        background: #e2e8f0;
        color: #4a5568;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
      }
      .toolbar input[type="search"] {
        flex: 1;
        min-width: 200px;
        padding: 7px 12px;
        border: 1px solid #cbd5e0;
        border-radius: 6px;
        font-size: 13px;
        font-family: inherit;
      }
      .toolbar select {
        padding: 6px 10px;
        border: 1px solid #cbd5e0;
        border-radius: 6px;
        font-size: 12px;
        font-family: inherit;
        background: #fff;
      }
      .filter-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ebf8ff;
        color: #2c5282;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
      }
      .filter-tag button {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        font-size: 14px;
        padding: 0;
        line-height: 1;
      }
      .clear-filters {
        background: #edf2f7;
        border: 1px solid #cbd5e0;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 12px;
        font-family: inherit;
      }
      .clear-filters:hover {
        background: #e2e8f0;
      }

      .truncate {
        max-width: 360px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .highlight {
        background: #fefcbf;
        padding: 0 2px;
        border-radius: 2px;
      }
      .empty {
        padding: 40px;
        text-align: center;
        color: #a0aec0;
      }
      .info-line {
        font-size: 12px;
        color: #718096;
        margin: 0 0 10px;
      }

      .pagination {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
        padding: 16px 0;
        font-size: 13px;
      }
      .pagination button {
        padding: 5px 10px;
        border: 1px solid #cbd5e0;
        background: #fff;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
      }
      .pagination button:disabled {
        opacity: 0.4;
        cursor: default;
      }

      .row-flag {
        display: inline-flex;
        gap: 2px;
      }

      .ev-status {
        font-size: 10px;
        margin-left: 4px;
        padding: 1px 4px;
        border-radius: 3px;
        font-weight: 700;
      }
      .ev-status.ok {
        background: #c6f6d5;
        color: #22543d;
      }
      .ev-status.fail {
        background: #fed7d7;
        color: #742a2a;
      }
    
  .ev-input { color: #2b6cb0; font-weight: 600; background: #ebf8ff; padding: 0 3px; border-radius: 3px; }
  .ev-before {
        color: #718096;
        text-decoration: line-through;
        text-decoration-color: #e53e3e;
      }
      .ev-after {
        color: #22543d;
        font-weight: 700;
      }
      .ev-arrow {
        color: #718096;
        margin: 0 4px;
      }

      .ev-arrow {
        font-size: 10px;
        color: #718096;
        font-weight: 500;
      }

      /* Truth filter */
      .truth-picker {
        background: #fff;
        border: 1px solid #cbd5e0;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 12px;
      }
      .truth-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 0;
        border-bottom: 1px dashed #edf2f7;
        font-size: 12px;
      }
      .truth-row:last-of-type {
        border-bottom: none;
      }
      .truth-label {
        flex: 1;
        color: #4a5568;
      }
      .truth-btns {
        display: flex;
        gap: 4px;
      }
      .truth-btns button {
        font-size: 11px;
        padding: 3px 10px;
        border: 1px solid #cbd5e0;
        background: #fff;
        border-radius: 5px;
        cursor: pointer;
        font-family: inherit;
      }
      .truth-btns button:hover {
        background: #edf2f7;
      }
      .truth-btns button.active {
        background: #3182ce;
        color: #fff;
        border-color: #3182ce;
      }
      .ev-passive {
        background: #f7fafc;
        color: #4a5568;
        font-weight: 500;
      }

      .fx-badge {
        cursor: help;
        font-family: "JetBrains Mono", monospace;
      }
      .fx-badge:hover {
        background: #cbd5e0;
      }

      /* Column picker */
      .col-picker-btn {
        padding: 6px 12px;
        border: 1px solid #cbd5e0;
        background: #fff;
        border-radius: 6px;
        cursor: pointer;
        font-size: 12px;
        font-family: inherit;
      }
      .col-picker-btn:hover {
        background: #edf2f7;
      }
      .col-picker {
        background: #fff;
        border: 1px solid #cbd5e0;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }
      .col-picker-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 10px 0 6px;
        font-size: 12px;
        color: #2d3748;
      }
      .col-picker-head:first-child {
        margin-top: 0;
      }
      .col-picker-head b {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #718096;
      }
      .col-picker-head button {
        font-size: 10.5px;
        padding: 2px 8px;
        border: 1px solid #cbd5e0;
        background: #f7fafc;
        border-radius: 5px;
        cursor: pointer;
        font-family: inherit;
      }
      .col-picker-head button:hover {
        background: #edf2f7;
      }
      .col-picker-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 4px 12px;
        margin-bottom: 10px;
      }
      .col-picker-grid label {
        font-size: 11.5px;
        display: flex;
        align-items: center;
        gap: 5px;
        color: #2d3748;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
      }
      .col-picker-grid label:hover {
        background: #edf2f7;
      }
      .ev-pid-inline {
        display: inline-block;
        background: #2c5282;
        color: #fff;
        font-size: 9.5px;
        font-weight: 700;
        padding: 0px 4px;
        border-radius: 6px;
        letter-spacing: 0.3px;
      }
      .col-picker-focus {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 6px;
      }
      .col-picker-focus button {
        font-size: 11.5px;
        padding: 4px 10px;
        border: 1px solid #cbd5e0;
        background: #fff;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
      }
      .col-picker-focus button:hover {
        background: #edf2f7;
      }
      .col-picker-focus button.active {
        background: #3182ce;
        color: #fff;
        border-color: #3182ce;
      }

      /* Evidence columns */
      .ev-cell {
        font-size: 11px;
        text-align: center;
        white-space: nowrap;
        padding: 6px 8px;
        font-weight: 600;
      }
      .ev-empty {
        background: #fafafa;
      }
      .ev-flag-col {
        background: #fffbea;
        color: #744210;
      } /* เหลืองอ่อน: P ที่ flag */
      .ev-match-ok {
    background: #38a169;
    color: #ffffff;
    font-weight: 700;
  } /* เขียว: จริง */
      .ev-match-fail {
    background: #e53e3e;
    color: #ffffff;
    font-weight: 700;
  } /* แดง: เท็จ */

      .ev-th {
        vertical-align: middle;
      }
      .ev-th .ev-pid {
        display: inline-block;
        background: #2c5282;
        color: #fff;
        font-size: 9.5px;
        font-weight: 700;
        padding: 1px 5px;
        border-radius: 8px;
        margin-right: 4px;
        vertical-align: middle;
        letter-spacing: 0.3px;
      }
      .ev-th .ev-lbl {
        display: inline;
        vertical-align: middle;
        font-weight: 600;
        color: #2d3748;
      }
      /* P-specific badge colors */
      .ev-th[data-p="P1"] .ev-pid {
        background: #3182ce;
      }
      .ev-th[data-p="P2"] .ev-pid {
        background: #3182ce;
      }
      .ev-th[data-p="P3"] .ev-pid {
        background: #c53030;
      }
      .ev-th[data-p="P4"] .ev-pid {
        background: #c53030;
      }
      .ev-th[data-p="P5"] .ev-pid {
        background: #dd6b20;
      }
      .ev-th[data-p="P6"] .ev-pid {
        background: #dd6b20;
      }
      .ev-th[data-p="P7"] .ev-pid {
        background: #38a169;
