function rowKey(sheet, r) {
  const cols = KEY_COLS[sheet];
  if (!cols) return null;
  const parts = cols.map((c) => String(r[c] == null ? "" : r[c]).trim().slice(0, 30));
  if (parts.every((p) => !p)) return null;
  return parts.join("||");
}


