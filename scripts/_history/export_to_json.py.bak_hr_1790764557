#!/usr/bin/env python3
"""
export_to_json.py (v2)
- โหลด workbook 2 รอบ: data_only=False (formula) + data_only=True (cached)
- merge: ถ้า cell เป็น formula แต่มี cached value → ใช้ cached
- ถ้า formula แต่ไม่มี cached → ใส่ '[fx]' เพื่อให้ UI รู้ว่ายังไม่คำนวณ
"""
import openpyxl
import json
from datetime import datetime, date, time, timezone
from pathlib import Path
from collections import Counter

SRC = 'outputs/whiteshirt_interview_master_WORKING.xlsx'
OUT = 'outputs/data.json'
HEADER_ROW = 4


def normalize(v):
    """แปลง value ให้เป็น JSON-safe"""
    if v is None:
        return None
    if isinstance(v, datetime):
        # ถ้า time เป็น 00:00:00 ให้เหลือแค่ date
        if v.hour == 0 and v.minute == 0 and v.second == 0:
            return v.strftime('%Y-%m-%d')
        return v.strftime('%Y-%m-%d %H:%M:%S')
    if isinstance(v, date):
        return v.strftime('%Y-%m-%d')
    if isinstance(v, time):
        return v.strftime('%H:%M')
    if isinstance(v, (int, float)):
        return v
    if isinstance(v, bool):
        return v
    s = str(v).strip()
    if s == '':
        return None
    return s


def is_formula(v):
    return isinstance(v, str) and v.lstrip().startswith('=')


def merge_cell(formula_v, cached_v):
    """
    เลือกค่าที่จะเก็บ:
    - ไม่มีทั้งคู่ → None
    - มีแต่ cached (ไม่มี formula) → cached
    - มี formula + cached → cached (ค่าที่คำนวณแล้ว)
    - มี formula แต่ไม่มี cached → '[fx]' (คำนวณไม่ได้)
    """
    if formula_v is None and cached_v is None:
        return None

    if is_formula(formula_v):
        if cached_v is None:
            return '[fx]'
        return normalize(cached_v)

    if formula_v is not None:
        return normalize(formula_v)

    return normalize(cached_v)


def sheet_to_records(ws, ws_cached, header_row=HEADER_ROW):
    max_row = max(ws.max_row or 0, ws_cached.max_row or 0)
    max_col = max(ws.max_column or 0, ws_cached.max_column or 0)

    headers = []
    for c in range(1, max_col + 1):
        h = ws.cell(row=header_row, column=c).value
        if h is None:
            h = ws_cached.cell(row=header_row, column=c).value
        headers.append(str(h).strip() if h else f'col{c}')

    records = []
    for r in range(header_row + 1, max_row + 1):
        row = {}
        empty = True
        for c in range(1, max_col + 1):
            v_f = ws.cell(row=r, column=c).value
            v_c = ws_cached.cell(row=r, column=c).value
            v = merge_cell(v_f, v_c)
            row[headers[c - 1]] = v
            if v not in (None, ''):
                empty = False
        if not empty:
            row['_row'] = r
            records.append(row)
    return headers, records


def main():
    src = Path(SRC)
    if not src.exists():
        print(f"FAIL: {SRC} not found")
        raise SystemExit(1)

    print(f"Loading {SRC} ...")
    wb = openpyxl.load_workbook(SRC, data_only=False, read_only=False)
    wb_cached = openpyxl.load_workbook(SRC, data_only=True, read_only=False)

    out = {
        'generated_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
        'source': SRC,
        'sheets': {},
    }

    fx_counts = Counter()
    total_fx = 0

    for name in wb.sheetnames:
        if name == 'README_START_HERE':
            continue
        ws = wb[name]
        ws_c = wb_cached[name]
        headers, records = sheet_to_records(ws, ws_c)

        # นับ [fx] ต่อ sheet
        n_fx = 0
        for rec in records:
            for k, v in rec.items():
                if v == '[fx]':
                    n_fx += 1
        if n_fx:
            fx_counts[name] = n_fx
            total_fx += n_fx

        out['sheets'][name] = {
            'headers': headers,
            'row_count': len(records),
            'records': records,
        }
        print(f"  {name}: {len(records)} records, {len(headers)} columns"
              + (f"  [{n_fx} fx-unresolved]" if n_fx else ""))

    wb.close()
    wb_cached.close()

    Path(OUT).write_text(json.dumps(out, ensure_ascii=False, indent=1), encoding='utf-8')

    print()
    print(f"Wrote {OUT}")
    print(f"Size: {Path(OUT).stat().st_size / 1024:.1f} KB")

    if total_fx:
        print()
        print(f"WARNING: {total_fx} cells unresolved (formula without cached value):")
        for sheet, n in fx_counts.most_common():
            print(f"  {sheet}: {n}")
        print()
        print("To fix: open the workbook in LibreOffice/Excel once and re-save,")
        print("or run: soffice --headless --convert-to xlsx --outdir /tmp <file>")
    else:
        print()
        print("OK: all formulas resolved from cache")


if __name__ == '__main__':
    main()
